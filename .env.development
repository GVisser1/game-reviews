# `pnpm dev` talks to the local Supabase from `pnpm exec supabase start`, never to production. Vite ranks this file
# above .env.local in development, and ignores it when building. These are the CLI's fixed local defaults, not secrets.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Local auth doesn't check captchas, so the app skips Turnstile.
VITE_TURNSTILE_SITE_KEY=